<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="640.0" prefWidth="800.0" 
            xmlns="http://javafx.com/javafx/23.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.patrones.adaptativos.controlador.PrimaryController"
            style="-fx-background-color: #ADD8E6;">
   
   <center>
      <VBox alignment="CENTER" spacing="20">
          <Label text="Bienvenido Jugador" textFill="#2C3E50">
             <font>
                <Font name="Arial Black" size="28.0" />
             </font>
          </Label>
          
          <Label text="Ingresa tu apodo:" />
          <TextField fx:id="nombreField" maxWidth="250.0" promptText="Ej: Jugador1" />
      </VBox>
   </center>
   
   <bottom>
      <BorderPane style="-fx-padding: 0 0 100 0;">
         <center>
            <Button alignment="CENTER" 
                    mnemonicParsing="false" 
                    onAction="#switchToSecondary" 
                    prefHeight="42.0" 
                    prefWidth="253.0" 
                    text="INICIAR JUEGO" 
                    style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-background-color: #FFFFFF;" />
         </center>
      </BorderPane>
   </bottom>
</BorderPane>