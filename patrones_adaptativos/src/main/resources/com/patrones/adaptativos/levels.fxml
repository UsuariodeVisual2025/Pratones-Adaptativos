<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="640.0" prefWidth="800.0" style="-fx-background-color: #ADD8E6;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.patrones.adaptativos.LevelsController">

    <top>
        <Button onAction="#volver" prefHeight="40" prefWidth="40" text="←" BorderPane.alignment="TOP_LEFT" />
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">

            <Label text="Patrones Adaptativos">
                <font>
                    <Font name="Arial Black" size="26" />
                </font>
            </Label>

            <Button onAction="#nivel1" prefHeight="52.0" prefWidth="211.0" text="Nivel 1 - Principiante" />
            <Button onAction="#nivel2" prefHeight="52.0" prefWidth="210.0" text="Nivel 2 - Intermedio" />
            <Button onAction="#nivel3" prefHeight="52.0" prefWidth="210.0" text="Nivel 3 - Difícil" />
            <Button onAction="#nivel4" prefHeight="52.0" prefWidth="210.0" text="Nivel 4 - Experto" />
         <Button text="Ver Puntajes" onAction="#verPuntajes"/>
            <padding>
               <Insets right="5.0" />
            </padding>
         
         <opaqueInsets>
            <Insets top="5.0" />
         </opaqueInsets>

        </VBox>
    </center>

</BorderPane>
