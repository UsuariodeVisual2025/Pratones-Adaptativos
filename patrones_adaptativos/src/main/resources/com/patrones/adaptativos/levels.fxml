<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane prefHeight="640.0" prefWidth="800.0" 
            style="-fx-background-color: linear-gradient(to bottom right, #4facfe 0%, #00f2fe 100%);" 
            xmlns="http://javafx.com/javafx/23.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.patrones.adaptativos.controlador.LevelsController">

    <top>
        <Button onAction="#volver" prefHeight="45" prefWidth="90" text="← VOLVER" 
                style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;">
            <BorderPane.margin>
                <Insets top="20.0" left="20.0" />
            </BorderPane.margin>
        </Button>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15">
            <Label text="PATRONES ADAPTATIVOS" textFill="WHITE" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">
                <font>
                    <Font name="Arial Rounded MT Bold" size="36" />
                </font>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </Label>

            <!-- Nivel 1 - Verde (Fácil) -->
            <Button onAction="#nivel1" prefHeight="55.0" prefWidth="250.0" text="Nivel 1 - Principiante" 
                    style="-fx-background-color: #2ecc71; -fx-background-radius: 25; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3);" />
            
            <!-- Nivel 2 - Amarillo (Medio) -->
            <Button onAction="#nivel2" prefHeight="55.0" prefWidth="250.0" text="Nivel 2 - Intermedio" 
                    style="-fx-background-color: #f1c40f; -fx-background-radius: 25; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3);" />
            
            <!-- Nivel 3 - Naranja (Difícil) -->
            <Button onAction="#nivel3" prefHeight="55.0" prefWidth="250.0" text="Nivel 3 - Difícil" 
                    style="-fx-background-color: #e67e22; -fx-background-radius: 25; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3);" />
            
            <!-- Nivel 4 - Rojo (Experto) -->
            <Button onAction="#nivel4" prefHeight="55.0" prefWidth="250.0" text="Nivel 4 - Experto" 
                    style="-fx-background-color: #e74c3c; -fx-background-radius: 25; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3);" />
            
            <Label text="__________________________" textFill="WHITE" opacity="0.5" />

            <!-- Ver Puntajes - Azul Oscuro -->
            <Button onAction="#verPuntajes" prefHeight="55.0" prefWidth="250.0" text="VER PUNTAJES" 
                    style="-fx-background-color: #34495e; -fx-background-radius: 25; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3);" />
        </VBox>
    </center>

</BorderPane>