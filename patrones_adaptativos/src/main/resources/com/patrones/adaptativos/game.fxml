<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<BorderPane prefHeight="600" prefWidth="800" 
            style="-fx-background-color: linear-gradient(to bottom right, #4facfe 0%, #00f2fe 100%);" 
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.patrones.adaptativos.controlador.GameController">

    <top>
        <BorderPane style="-fx-padding:15;">
            <left>
                <Button onAction="#volverNiveles" text="← VOLVER" 
                        style="-fx-background-color: rgba(255,255,255,0.4); -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" />
            </left>
            <center>
                <Label text="PATRONES ADAPTATIVOS" 
                       style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill: #000000;" />
            </center>
        </BorderPane>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="25">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20" />
            </padding>

            <Label fx:id="patronLabel" text="Adivina el patrón: ..." 
                   style="-fx-font-size:28px; -fx-font-weight: bold; -fx-text-fill: #000000;" />
            
            <TextField fx:id="respuestaField" maxWidth="300" prefHeight="45" promptText="Ingresa el número" 
                       style="-fx-background-radius: 20; -fx-alignment: center; -fx-font-size: 18px; -fx-border-color: #000000; -fx-border-radius: 20;" />
            
            <Label fx:id="statusLabel" 
                   style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill: #000000;" />
            
            <HBox alignment="CENTER" spacing="20">
                <Button onAction="#comprobar" prefWidth="150" prefHeight="50" text="COMPROBAR" 
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 30; -fx-font-size: 14px; -fx-cursor: hand;" />
                <Button onAction="#reiniciar" prefWidth="150" prefHeight="50" text="REINICIAR" 
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 30; -fx-font-size: 14px; -fx-cursor: hand;" />
            </HBox>
            
            <!-- CONTENEDOR ESTILO TABLA DE PUNTAJES -->
            <VBox spacing="0" maxWidth="600" alignment="CENTER"
                  style="-fx-background-color: #1a5276; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #000000; -fx-border-width: 1;">
                
                <!-- Cabecera Manual Azul Oscuro -->
                <HBox alignment="CENTER" prefHeight="40.0" style="-fx-padding: 0 20 0 20;">
                    <children>
                        <Label text="INTENTO" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="RESPUESTA" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="RESULTADO" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" />
                    </children>
                </HBox>

                <!-- TableView CORREGIDA -->
                <TableView fx:id="tablaIntentos" prefHeight="220" 
                           style="-fx-background-color: white; -fx-background-radius: 0 0 13 13; -fx-border-radius: 0 0 13 13; -fx-border-color: transparent;">
                    <columns>
                        <!-- Las columnas DEBEN ser visibles para que JavaFX dibuje los datos -->
                        <TableColumn fx:id="colIntento" prefWidth="100" text="Intento" />
                        <TableColumn fx:id="colRespuesta" prefWidth="150" text="Respuesta" />
                        <TableColumn fx:id="colResultado" prefWidth="150" text="Resultado" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>