<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600" prefWidth="800" 
            style="-fx-background-color: linear-gradient(to bottom right, #4facfe 0%, #00f2fe 100%);" 
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.patrones.adaptativos.controlador.GameController">

    <top>
        <BorderPane style="-fx-padding:15;">
            <left>
                <Button onAction="#volverNiveles" text="← VOLVER" 
                        style="-fx-background-color: rgba(255,255,255,0.4); -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10;" />
            </left>
            <center>
                <!-- Título en Negro -->
            <Label text="PATRONES ADAPTATIVOS" 
                       style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill: #000000;" />
            </center>
        </BorderPane>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="25">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20" />
            </padding>

            <!-- Adivina el patrón en Negro -->
            <Label fx:id="patronLabel" text="Adivina el patrón: ..." 
                   style="-fx-font-size:28px; -fx-font-weight: bold; -fx-text-fill: #000000;" />
            
            <TextField fx:id="respuestaField" maxWidth="300" prefHeight="45" promptText="Ingresa el número" 
                       style="-fx-background-radius: 20; -fx-alignment: center; -fx-font-size: 18px; -fx-border-color: #000000; -fx-border-radius: 20;" />
            
            <!-- Estado del nivel en Negro -->
            <Label fx:id="statusLabel" 
                   style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill: #000000;" />
            
            <HBox alignment="CENTER" spacing="20">
                <Button onAction="#comprobar" prefWidth="150" prefHeight="50" text="COMPROBAR" 
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 30; -fx-font-size: 14px;" />
                <Button onAction="#reiniciar" prefWidth="150" prefHeight="50" text="REINICIAR" 
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 30; -fx-font-size: 14px;" />
            </HBox>
            
            <TableView fx:id="tablaIntentos" prefHeight="220" maxWidth="600" 
                       style="-fx-background-radius: 15; -fx-background-color: white; -fx-border-color: #000000; -fx-border-radius: 15;">
                <columns>
                    <TableColumn fx:id="colIntento" text="Intento" prefWidth="120" />
                    <TableColumn fx:id="colRespuesta" text="Respuesta" prefWidth="230" />
                    <TableColumn fx:id="colResultado" text="Resultado" prefWidth="230" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>