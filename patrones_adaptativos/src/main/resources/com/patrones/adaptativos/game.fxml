<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.patrones.adaptativos.GameController"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color:#ADD8E6">

    <top>
        <Label text="Patrones Adaptativos"
               style="-fx-font-size:24px; -fx-font-weight:bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER">

            <Label fx:id="patronLabel" text="2 4 6 ?" />

            <TextField fx:id="respuestaField"
                       promptText="Ingresa el siguiente número"/>

            <HBox spacing="10">
                <Button text="Comprobar" onAction="#comprobar"/>
                <Button text="Reiniciar" onAction="#reiniciar"/>
            </HBox>

            <TableView fx:id="tablaIntentos" prefWidth="400">

                <columns>
                    <TableColumn text="Intento" fx:id="colIntento"/>
                    <TableColumn text="Respuesta" fx:id="colRespuesta"/>
                    <TableColumn text="Resultado" fx:id="colResultado"/>
                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>