<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="600" prefWidth="800" 
            style="-fx-background-color: linear-gradient(to bottom right, #4facfe 0%, #00f2fe 100%);" 
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.patrones.adaptativos.controlador.ScoresController">

    <top>
        <BorderPane style="-fx-padding: 15;">
            <left>
                <Button onAction="#volver" text="← VOLVER" 
                        style="-fx-background-color: rgba(255,255,255,0.4); -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 15; -fx-cursor: hand;" />
            </left>
        </BorderPane>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="0"> <!-- Spacing 0 para que la cabecera y la tabla se peguen -->
            <padding>
                <Insets top="10" right="30" bottom="40" left="30" />
            </padding>

            <Label text="TABLA DE PUNTAJES" 
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #000000; -fx-padding: 0 0 20 0;" />

            <!-- ESTA ES TU NUEVA CABECERA PERSONALIZADA -->
            <HBox maxWidth="750" prefHeight="40" alignment="CENTER_LEFT"
                  style="-fx-background-color: rgba(0, 0, 0, 0.6); -fx-background-radius: 20 20 0 0; -fx-padding: 0 10 0 10;">
                <Label text="Partida N°" prefWidth="100" textFill="WHITE" style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
                <Label text="Jugador" prefWidth="200" textFill="WHITE" style="-fx-font-weight: bold; -fx-padding: 0 0 0 15;" />
                <Label text="Puntaje" prefWidth="120" textFill="WHITE" style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
                <Label text="Nivel" prefWidth="120" textFill="WHITE" style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
                <Label text="Intentos" prefWidth="120" textFill="WHITE" style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
            </HBox>

            <!-- LA TABLA SIN CABECERA GRIS -->
            <TableView fx:id="tablaScores" maxWidth="750" prefHeight="400" 
                       style="-fx-background-color: rgba(255, 255, 255, 0.25); 
                              -fx-background-radius: 0 0 20 20; 
                              -fx-border-color: rgba(0, 0, 0, 0.2); 
                              -fx-border-radius: 0 0 20 20;
                              -fx-column-header-background: transparent; 
                              -fx-padding: 5;">
                <columns>
                    <!-- Las columnas se mantienen pero les quitamos el texto para que no se duplique -->
                    <TableColumn fx:id="colId" text="" prefWidth="100" style="-fx-alignment: CENTER; -fx-background-color: transparent;" />
                    <TableColumn fx:id="colJugador" text="" prefWidth="200" style="-fx-alignment: CENTER-LEFT; -fx-background-color: transparent; -fx-padding: 0 0 0 15;" />
                    <TableColumn fx:id="colPuntaje" text="" prefWidth="120" style="-fx-alignment: CENTER; -fx-background-color: transparent; -fx-font-weight: bold;" />
                    <TableColumn fx:id="colNivel" text="" prefWidth="120" style="-fx-alignment: CENTER; -fx-background-color: transparent;" />
                    <TableColumn fx:id="colIntentos" text="" prefWidth="120" style="-fx-alignment: CENTER; -fx-background-color: transparent;" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>